{
  "name": "@tm11/mmgeo",
  "version": "2.0.0",
  "description": "Myanmar states, districts and townships with MIMU P-codes, bilingual English/Burmese names, ranked Zawgyi-safe search and validation.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./data/db.json": "./data/db.json",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "data",
    "DATA_LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "build:data": "ts-node --transpile-only scripts/build-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "myanmar",
    "burma",
    "myanmar-address",
    "myanmar-townships",
    "myanmar-states",
    "myanmar-regions",
    "myanmar-districts",
    "townships",
    "address-form",
    "address-validation",
    "geo-data",
    "geography",
    "localization",
    "i18n",
    "burmese",
    "mmgeo",
    "pcode",
    "mimu",
    "zawgyi"
  ],
  "author": "tunmin tunmin2000@gmail.com",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunmin11/mmgeo"
  },
  "bugs": {
    "url": "https://github.com/tunmin11/mmgeo/issues"
  },
  "homepage": "https://tunmin11.github.io/mmgeo",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=14"
  }
}
